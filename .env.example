# Copy this file to .env and adjust values for your environment.
# The pipeline reads these at startup via python-dotenv.

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text:latest
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=rag_docs

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=64

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K=8
GRADING_ENABLED=true

# Search strategy: similarity | mmr | hybrid
SEARCH_STRATEGY=hybrid

# Hybrid weights — must sum to 1.0 (only used when SEARCH_STRATEGY=hybrid)
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Cross-encoder reranking
# ---------------------------------------------------------------------------
# Set RERANKER_ENABLED=true to activate retrieve-then-rerank.
# The model is downloaded from HuggingFace on first use (~80 MB).
#
# Recommended models (all are free, MIT/Apache licensed):
#   cross-encoder/ms-marco-MiniLM-L-6-v2   — fastest, ~80 MB  (default)
#   cross-encoder/ms-marco-MiniLM-L-12-v2  — more accurate, ~120 MB
#   cross-encoder/ms-marco-electra-base    — best quality, ~440 MB
#
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=4

# ---------------------------------------------------------------------------
# Query expansion
# ---------------------------------------------------------------------------
# Set QUERY_EXPANSION_ENABLED=true to generate N alternative phrasings before
# retrieval.  Result sets from all variations are merged and deduplicated.
# Adds one LLM round-trip; most useful for vague or short queries.
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_N=3

# ---------------------------------------------------------------------------
# Document preprocessing
# ---------------------------------------------------------------------------
# true  → clean artifacts, inject === SECTION === boundaries, prefix every
#          chunk with [Document | KB | Section] context (recommended)
# false → skip preprocessing (use if documents are already well-structured)
PREPROCESS_ENABLED=true

# ---------------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------------
# true  → DEBUG logging (shows retrieved chunks, grader decisions, routing)
# false → INFO logging  (high-level progress only)
VERBOSE=true
