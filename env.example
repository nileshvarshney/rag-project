# Copy this file to .env and edit as needed.
# All values below are already the defaults in config.py,
# so you only need to set them here if you want to override.

LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text:latest
OLLAMA_BASE_URL=http://localhost:11434

CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=rag_docs

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5

DOCS_DIR=./docs

# Disable ChromaDB telemetry (avoids posthog version-mismatch warnings)
ANONYMIZED_TELEMETRY=False

# Self-RAG: grade each chunk before passing to LLM (adds latency)
GRADING_ENABLED=true

# Search strategy: "similarity" | "mmr" | "hybrid"
SEARCH_STRATEGY=similarity

# Hybrid search weights (must sum to 1.0)
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
